# Resend (https://resend.com) — required for the contact form to send email
RESEND_API_KEY=

# Inbox that receives new lead notifications
CONTACT_EMAIL=derekj2011@gmail.com

# Verified sending address/domain in Resend (e.g. hello@justgeniusrecruiting.com)
# Falls back to Resend's shared onboarding@resend.dev sender if unset (fine for testing,
# not for production — verify a domain in Resend before launch).
RESEND_FROM_EMAIL=

# Optional: Calendly (or similar) booking link. When set, "Get a Recruiting
# Assessment" and other primary CTAs deep-link to it. When unset, they scroll
# to the contact form instead.
NEXT_PUBLIC_BOOKING_URL=

# Canonical production URL, used for metadata, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.justgeniusrecruiting.com
